# Copia este archivo a .env y ajusta valores. Nunca subas .env al repositorio.
PORT=5173
# Ruta de la base de datos SQLite (se crea sola).
DATABASE_PATH=./data/koppara.db
# Carpeta para archivos subidos a la biblioteca de medios.
UPLOAD_DIR=./data/uploads
# Clave de 32 bytes en base64 para cifrar tokens de integraciones (AES-256-GCM).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Proveedor de IA opcional. Sin clave se usan plantillas locales (no es IA).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Integraciones sociales: todas desactivadas hasta implementarse y autorizarse.
# Rellenar estas variables NO activa ninguna integración por sí solo.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
