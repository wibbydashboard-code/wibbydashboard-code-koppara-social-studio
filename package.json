{
  "name": "koppara-social-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Herramienta interna para preparar y organizar contenido social de Koppara.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --clear-screen=false --ignore \"web/**\" server/index.ts",
    "build": "vite build",
    "start": "tsx --disable-warning=ExperimentalWarning server/index.ts --production",
    "db:reset": "tsx --disable-warning=ExperimentalWarning server/db/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx tests/e2e/flow.ts",
    "screenshots": "tsx tests/e2e/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.3.0",
    "image-size": "^2.0.4",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
